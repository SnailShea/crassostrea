# --------------------------------------------------------------------------
# Crassostrea gateway - Postfix main configuration
# Please create a file "extra.cf" for persistent overrides to main.cf
# --------------------------------------------------------------------------
# Mail flow:
#   internet --> postscreen/smtpd (25) --> rspamd milter --> relay to the
#   downstream server configured per domain in the web UI (transport_maps)
#
#   Hosts in "relay networks" (web UI) may additionally send outbound mail
#   through the gateway; it is scanned by rspamd as well.
# --------------------------------------------------------------------------
biff = no
append_dot_mydomain = no
compatibility_level = 3.7
mail_name = Crassostrea
inet_interfaces = all
# inet_protocols, smtp_address_preference: system/configure.sh (IPV4_ENABLED, IPV6_ENABLED)

# Nothing is delivered locally except bounces to the watchdog
mydestination = localhost.localdomain, localhost
# EL10 builds Postfix without Berkeley DB: lmdb for every indexed table and cache
default_database_type = lmdb
alias_maps = lmdb:/etc/aliases
alias_database = lmdb:/etc/aliases
recipient_delimiter = +

# --------------------------------------------------------------------------
# Domains, recipients and routing (managed via the web UI / MySQL)
# --------------------------------------------------------------------------
# reports@$myhostname receives DMARC and TLS reports, spam@ and ham@ messages
# reported by users: rspamd hands them to the web UI (Reports and Training
# pages), Postfix then discards them
relay_domains = $myhostname, proxy:mysql:/etc/postfix/sql/mysql_relay_domains.cf
relay_recipient_maps = inline:{ reports@$myhostname=OK, spam@$myhostname=OK, ham@$myhostname=OK },
  proxy:mysql:/etc/postfix/sql/mysql_relay_recipient_maps.cf
# custom_transport.pcre can be used for manual routing overrides
transport_maps = pcre:/etc/postfix/custom_transport.pcre,
  inline:{ { reports@$myhostname = discard:handed to the web UI },
    { spam@$myhostname = discard:handed to the web UI }, { ham@$myhostname = discard:handed to the web UI } },
  pcre:/etc/postfix/local_transport,
  proxy:mysql:/etc/postfix/sql/mysql_transport_maps.cf
relayhost =

# mynetworks is completed by system/configure.sh: loopback and the relay
# networks from the web UI (/var/lib/crassostrea/postfix/relay_networks.cidr)
mynetworks_style = host

proxy_read_maps = $relay_domains,
  $relay_recipient_maps,
  $transport_maps,
  $local_recipient_maps,
  $mydestination,
  $virtual_alias_maps,
  $virtual_alias_domains,
  $virtual_mailbox_maps,
  $virtual_mailbox_domains,
  $canonical_maps,
  $sender_canonical_maps,
  $recipient_canonical_maps,
  $relocated_maps,
  $mynetworks,
  $smtp_tls_policy_maps,
  proxy:mysql:/etc/postfix/sql/mysql_recipient_verify.cf

# --------------------------------------------------------------------------
# SMTP restrictions
# --------------------------------------------------------------------------
smtpd_helo_required = yes
disable_vrfy_command = yes
smtpd_delay_reject = yes
smtpd_error_sleep_time = 10s
smtpd_soft_error_limit = 3
smtpd_hard_error_limit = ${stress?1}${stress:5}
smtpd_forbid_bare_newline = yes
smtpd_data_restrictions = reject_unauth_pipelining, permit
# A cluster node in maintenance answers new mail with 421, so senders use the
# other MX hosts (system/libexec/cluster-node; empty otherwise)
smtpd_client_restrictions = check_client_access cidr:/var/lib/crassostrea/postfix/maintenance.cidr,
  permit_mynetworks,
  check_client_access cidr:/var/lib/crassostrea/postfix/client_exempt.cidr,
  $sf_ptr_check
# Hosts without a reverse DNS name (Settings of the web UI): sf_ptr_check is
# empty or reject_unknown_reverse_client_hostname with unknown_client_reject_code
# 450 or 550 (system/configure.sh, system/libexec/postfix-apply). The IP
# addresses of the global allow list are exempt (client_exempt.cidr).
# Hosts without the rate limits of the web UI (Rate limits page): the relay
# networks, loopback and the exempt networks
smtpd_client_event_limit_exceptions = $mynetworks cidr:/var/lib/crassostrea/postfix/rate_limit_exempt.cidr
smtpd_relay_restrictions = permit_mynetworks,
  reject_unauth_destination
smtpd_helo_restrictions = permit_mynetworks,
  reject_invalid_helo_hostname
smtpd_sender_restrictions = permit_mynetworks,
  reject_non_fqdn_sender,
  reject_unknown_sender_domain
# Recipients are validated against relay_recipient_maps (accept-all, a
# recipient list, or SMTP call-ahead verification against the downstream
# server, selectable per domain).
smtpd_recipient_restrictions = permit_mynetworks,
  reject_non_fqdn_recipient,
  reject_unauth_destination,
  check_recipient_access proxy:mysql:/etc/postfix/sql/mysql_recipient_verify.cf,
  permit
smtpd_reject_unlisted_recipient = yes
unverified_recipient_reject_code = 550
unverified_recipient_tempfail_action = defer_if_permit
address_verify_map = lmdb:$data_directory/verify_cache
plaintext_reject_code = 550

# --------------------------------------------------------------------------
# postscreen (first line of defence on port 25)
# --------------------------------------------------------------------------
postscreen_access_list = permit_mynetworks,
  cidr:/etc/postfix/custom_postscreen_whitelist.cidr,
  cidr:/etc/postfix/postscreen_access.cidr
postscreen_bare_newline_enable = no
postscreen_denylist_action = drop
postscreen_cache_cleanup_interval = 24h
postscreen_cache_map = proxy:lmdb:$data_directory/postscreen_cache
postscreen_dnsbl_action = enforce
postscreen_dnsbl_threshold = 6
postscreen_dnsbl_ttl = 5m
postscreen_greet_action = enforce
postscreen_greet_banner = $smtpd_banner
postscreen_greet_ttl = 2d
postscreen_greet_wait = 3s
postscreen_non_smtp_command_enable = no
postscreen_pipelining_enable = no
postscreen_discard_ehlo_keywords = chunking, silent-discard, smtputf8, dsn
smtpd_discard_ehlo_keywords = chunking, silent-discard, smtputf8

# --------------------------------------------------------------------------
# Content filter
# --------------------------------------------------------------------------
smtpd_milters = inet:127.0.0.1:9900
non_smtpd_milters = inet:127.0.0.1:9900
milter_default_action = tempfail
milter_protocol = 6
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}

# --------------------------------------------------------------------------
# Queue
# --------------------------------------------------------------------------
# Set in the web UI (Settings -> Message limits): system/libexec/postfix-apply
message_size_limit = 52428800
mailbox_size_limit = 0
bounce_queue_lifetime = 1d
maximal_queue_lifetime = 5d
# Queue IDs that are never reused: the mail log joins Postfix's delivery
# results to messages by queue ID (system/libexec/logship)
enable_long_queue_ids = yes
delay_warning_time = 4h
queue_run_delay = 300s
minimal_backoff_time = 300s
maximal_backoff_time = 1800s

# --------------------------------------------------------------------------
# TLS
# --------------------------------------------------------------------------
# One certificate (CRASSOSTREA_HOSTNAME + ADDITIONAL_SAN), see system/libexec/acme
smtpd_tls_cert_file = /etc/crassostrea/ssl/cert.pem
smtpd_tls_key_file = /etc/crassostrea/ssl/key.pem
smtpd_tls_received_header = yes
smtpd_tls_security_level = may
smtpd_tls_loglevel = 1
smtpd_tls_exclude_ciphers = ECDHE-RSA-RC4-SHA, RC4, aNULL, DES-CBC3-SHA, ECDHE-RSA-DES-CBC3-SHA, EDH-RSA-DES-CBC3-SHA
smtpd_tls_mandatory_ciphers = high
# smtpd_tls_protocols, tls_config_file: system/configure.sh (SMTP_TLS_MIN)

smtp_tls_CAfile = /etc/pki/tls/certs/ca-bundle.crt
smtp_tls_cert_file = /etc/crassostrea/ssl/cert.pem
smtp_tls_key_file = /etc/crassostrea/ssl/key.pem
smtp_tls_session_cache_database = lmdb:${data_directory}/smtp_scache
smtp_tls_loglevel = 1
smtp_dns_support_level = dnssec
smtp_tls_security_level = dane
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_protocols = >=TLSv1.2
# DANE / MTA-STS policy lookups for outbound and downstream delivery.
# QUERY, not QUERYwithTLSRPT: the TLSRPT attributes of that answer need
# Postfix 3.10, and older versions defer every message to a domain with an
# MTA-STS policy ("client TLS configuration problem")
smtp_tls_policy_maps = socketmap:inet:127.0.0.1:8642:QUERY

tls_preempt_cipherlist = yes
tls_ssl_options = NO_COMPRESSION, NO_RENEGOTIATION
parent_domain_matches_subdomains = debug_peer_list,fast_flush_domains,mynetworks,qmqpd_authorized_clients

# DO NOT EDIT ANYTHING BELOW #
# Overrides #
