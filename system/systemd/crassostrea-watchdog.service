[Unit]
Description=Crassostrea: watchdog (health checks, restarts, notifications)
After=network-online.target postfix.service rspamd.service nginx.service

[Service]
# root: restarts units, reads the postfix queue
Environment="WATCHDOG_SUBJECT=Watchdog ALERT" WATCHDOG_NOTIFY_BAN=y WATCHDOG_NOTIFY_START=y WATCHDOG_VERBOSE=n
Environment=USE_WATCHDOG=y DEV_MODE=n SKIP_CLAMD=n SKIP_OLEFY=n SKIP_LETS_ENCRYPT=n HTTPS_PORT=443 CHECK_UNBOUND=1
Environment=NGINX_THRESHOLD=5 UNBOUND_THRESHOLD=5 REDIS_THRESHOLD=5 MYSQL_THRESHOLD=5 WEB_THRESHOLD=5
Environment=POSTFIX_THRESHOLD=8 POSTFIX_TLSPOL_THRESHOLD=8 CLAMD_THRESHOLD=15
Environment=FAIL2BAN_THRESHOLD=1 ACME_THRESHOLD=1 RSPAMD_THRESHOLD=5 OLEFY_THRESHOLD=5 MAILQ_THRESHOLD=20 MAILQ_CRIT=30
Environment=GALERA_THRESHOLD=3
# crassostrea.conf overrides the defaults above
EnvironmentFile=/etc/crassostrea/crassostrea.conf
ExecStart=/usr/local/libexec/crassostrea/watchdog/watchdog.sh
Restart=always
RestartSec=10
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
